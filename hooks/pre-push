#!/usr/bin/env bash
# Dokima pre-push (P0-04) — runs `pnpm validate` (the six repo validators +
# temp-leak check, ~seconds; NOT lint/tests/e2e — those are CI's and the
# conductor receipt gate's job, and a push must not cost minutes).
# Bypass: git push --no-verify.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
pnpm validate || {
  echo "pre-push: pnpm validate failed — fix or push --no-verify with a reason in the commit." >&2
  exit 1
}
exit 0

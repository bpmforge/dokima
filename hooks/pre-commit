#!/usr/bin/env bash
# Dokima pre-commit (P0-04) — seconds-budget gate on STAGED files only.
#
# Runs:   prettier --check on staged files · secrets scan on staged content
# Skips:  lint, typecheck, tests, e2e, pnpm validate — those live in the
#         pre-push hook, CI, and the conductor's receipt gate (Law L1).
# Bypass: git commit --no-verify (visible in reflog; use for emergencies only).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1) format check on staged, prettier-supported files (budget: ~1-3s)
fmt=$(echo "$staged" | grep -E '\.(ts|tsx|mjs|js|jsx|json|css|md|yml|yaml)$' || true)
if [ -n "$fmt" ]; then
  # shellcheck disable=SC2086
  npx prettier --check $fmt || {
    echo "pre-commit: prettier --check failed. Fix with: npx prettier --write <files>" >&2
    exit 1
  }
fi

# 2) secrets scan on the staged DIFF, not the tree (budget: <1s)
if git diff --cached -U0 | grep -E -i \
  -e '-----BEGIN (RSA|EC|OPENSSH|DSA|PGP) PRIVATE KEY-----' \
  -e '(api[_-]?key|secret|token|passwd|password)["'"'"':= ]+[A-Za-z0-9_\-]{20,}' \
  -e 'AKIA[0-9A-Z]{16}' \
  -e 'ghp_[A-Za-z0-9]{36}' \
  -e 'sk-(ant|proj)-[A-Za-z0-9_\-]{20,}'; then
  echo "pre-commit: possible secret in staged diff (Law: secrets never in code — FR-S2). Use a credential ref." >&2
  exit 1
fi
exit 0

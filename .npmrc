# SC-16 supply-chain policy (docs/SECURITY_CONTROLS.md, docs/TECH_STACK.md).
# Dependency lifecycle scripts are untrusted by default. The one allowed
# exception (native build for better-sqlite3, plus esbuild's postinstall)
# is granted narrowly via pnpm-workspace.yaml's `allowBuilds` allowlist,
# not by disabling this flag — verified: `ignore-scripts=true` + that
# allowlist still produces a working better-sqlite3 native binary.
ignore-scripts=true
